{
  "name": "@luaskills/sdk",
  "version": "0.5.5",
  "description": "TypeScript and Node.js SDK for integrating the LuaSkills runtime through the JSON FFI surface.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "luaskills": "dist/cli.js"
  },
  "files": [
    "dist",
    "contracts",
    "examples",
    "scripts/deps/*.ps1",
    "scripts/deps/*.sh",
    "scripts/ffi/*.ps1",
    "scripts/ffi/*.sh",
    "scripts/debug-tools/*.py",
    "src",
    "README.md",
    "README_cn.md",
    "VERSION"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "generate:config-contract": "node scripts/generate-skill-config-contract.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "node scripts/generate-skill-config-contract.mjs --check && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node tests/run-all.mjs",
    "test:private-url-manifest": "npm run build && node tests/private-url-manifest.mjs",
    "test:runtime-lease-actions": "npm run build && node tests/runtime-lease-actions.mjs",
    "test:skill-lifecycle-actions": "npm run build && node tests/skill-lifecycle-actions.mjs",
    "test:skill-install-source-types": "npm run build && node tests/skill-install-source-types.mjs",
    "test:skill-operation-progress-callback": "npm run build && node tests/skill-operation-progress-callback.mjs",
    "test:system-management-raw-call-boundary": "npm run build && node tests/system-management-raw-call-boundary.mjs",
    "test:client-lifecycle-boundary": "npm run build && node tests/client-lifecycle-boundary.mjs",
    "test:ffi-envelope-errors": "npm run build && node tests/ffi-envelope-errors.mjs",
    "test:runtime-manifest-errors": "npm run build && node tests/runtime-manifest-errors.mjs",
    "test:runtime-manifest-host-options": "npm run build && node tests/runtime-manifest-host-options.mjs",
    "test:runtime-archive-validation": "npm run build && node tests/runtime-archive-validation.mjs",
    "test:runtime-checksum-validation": "npm run build && node tests/runtime-checksum-validation.mjs",
    "test:runtime-managed-path-validation": "npm run build && node tests/runtime-managed-path-validation.mjs",
    "example:basic": "node examples/basic.mjs",
    "example:call": "node examples/call.mjs",
    "example:host-tool-callback": "node examples/host-tool-callback.mjs",
    "example:lifecycle": "node examples/lifecycle.mjs",
    "example:provider-callback": "node examples/provider-callback.mjs",
    "example:query": "node examples/query.mjs",
    "example:runtime-lease": "node examples/runtime-lease.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "lua",
    "skills",
    "ffi",
    "runtime",
    "sdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuaSkills/luaskills-sdk-typescript.git"
  },
  "dependencies": {
    "koffi": "^2.14.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=24"
  }
}
